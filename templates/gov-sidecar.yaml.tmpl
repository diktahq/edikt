# yaml-language-server: $schema={{schema_path}}
# Governance sidecar — co-located with an ADR / invariant / guideline .md.
# Generated by the sidecar-extractor agent. Edit prose in the parent .md,
# then re-run /edikt:<artifact>:compile to regenerate this file.
#
# Required keys (per templates/schemas/gov-sidecar.v1.schema.json):
#   schema_version  (integer 1 — NOT "1", NOT "v1")
#   topic           (kebab-case, ^[a-z][a-z0-9-]{0,39}$)
#   path            (relative path to parent .md)
#   signals         (array of lowercase phrases)
#   directives      (array — may be empty)
#
# additionalProperties: false — unknown top-level keys are rejected.

schema_version: 1
topic: "{{topic}}"
path: "{{path}}"

# Routing keywords — lowercase noun phrases that surface this artifact
# for search and for the benchmark's attack corpus. Multi-word
# phrases preferred over single words.
signals: []

# Optional v1.1 fields — uncomment if needed.
# paths: []     # File-glob patterns scoping where directives apply.
# scope: []    # Lifecycle phases: planning | design | implementation | review.

# Auto-extracted directives. Each carries a verbatim source_excerpt
# anchored to the parent .md (line_start, line_end, quote).
# Re-extracted on every /edikt:<artifact>:compile run.
#
# Each directive MAY carry a `verify:` shell command run by
# `bin/edikt verify gov <id>`. Exit 0 = the directive holds. Omit when no
# mechanical check is possible — never fabricate. Example shape:
#   - text: "MUST use json.dumps to construct JSON in hook scripts"
#     source_excerpt: {line_start: 12, line_end: 14, quote: "..."}
#     verify: "! rg -P 'echo.*\\\"\\{.*\\}' templates/hooks/*.sh"
#
# verify_kind examples — one directive of each kind (required whenever verify: is set):
#
# Structural — pattern/file check; no runtime required:
#   - text: "MUST NOT build JSON via shell string concatenation. (ref: INV-NNN)"
#     source_excerpt: {line_start: 42, line_end: 42, quote: "..."}
#     verify: "! rg -E 'echo.*json|printf.*\\{' templates/hooks/"
#     verify_kind: structural
#
# Tooling — linter / static-analysis / CI gate:
#   - text: "MUST pass go vet before any release build. (ref: ADR-NNN)"
#     source_excerpt: {line_start: 17, line_end: 17, quote: "..."}
#     verify: "cd tools/edikt && go vet ./..."
#     verify_kind: tooling
#
# Behavioral — runtime observable outcome (requires human_approved_at):
#   - text: "POST /api/v1/ai/ask MUST return 202 Accepted immediately. (ref: ADR-NNN)"
#     source_excerpt: {line_start: 8, line_end: 8, quote: "..."}
#     verify: "curl -s -o /dev/null -w '%{http_code}' http://localhost:8080/api/v1/ai/ask | grep -qx 202"
#     verify_kind: behavioral
#     intent: "the handler accepts the request and defers processing asynchronously"
#     falsifying_observation: "the request blocks until processing completes before returning"
#     human_approved_at: "2026-05-22T12:00:00Z"
directives: []

# MUST NOT directives synthesised from rejected ## Considered Options (ADRs only).
# Each entry needs a source_excerpt pointing at a Cons: bullet in the parent.
# Extractor never invents — entries map 1:1 to rejected-option text.
# Prohibitions accept the same optional verify: field as directives.
# Example shape:
#   - text: "MUST NOT introduce a top-level go.mod at the tier-1 root"
#     source_excerpt: {line_start: 30, line_end: 32, quote: "..."}
#     verify: "! test -f go.mod"
# prohibitions: []

# User-authored directives preserved across regeneration.
# Add rules here that don't appear verbatim in the parent prose.
# Always included in the effective rule set.
manual_directives: []

# Auto-directives the user rejected. Subtracted from directives[] at compile.
suppressed_directives: []

# Pre-action reminders aggregated into governance.md § Reminders.
# Format: "Before {action} → {check} (ref: {ID})"
reminders: []

# Verification checklist items aggregated into governance.md § Verification Checklist.
# Two accepted shapes (oneOf in the schema):
#   - "[ ] bare-string checklist item (ref: ADR-NNN)"        # legacy form
#   - text: "[ ] structured form (ref: ADR-NNN)"             # preferred for new entries
#     verify: "<shell command, exit 0 = checklist item holds>"
# The structured form lets `bin/edikt verify gov <id>` run the checklist
# mechanically. Omit verify when no programmatic check exists.
verification: []
